{
  "SoilNode": {
    "description": "Plant sensor: air temperature and humidity, soil moisture, battery",
    "match": {"has": [1, 2, 3, 6], "lacks": [20, 40]},
    "headline": ["d:soil", "1", "2", "d:battery"],
    "slots": {
      "1":  {"label": "Air temperature", "unit": "°C", "scale": 0.01, "decimals": 1, "chart": true, "valid": [-4000, 8500]},
      "2":  {"label": "Humidity", "unit": "%RH", "scale": 0.01, "decimals": 0, "chart": true, "valid": [1, 10000]},
      "3":  {"label": "Soil (raw ADC)", "chart": true},
      "4":  {"label": "Soil (firmware %)", "unit": "%", "note": "uses the placeholder calibration compiled in; the admin's own soil % uses yours"},
      "5":  {"label": "Battery voltage (raw)", "unit": "V", "scale": 0.001, "decimals": 2, "chart": true, "zero_means": "no divider fitted", "note": "as the node measures it; the calibrated value applies this board's correction"},
      "6":  {"label": "Sensors ok", "bits": {"1": "air sensor", "2": "soil probe", "4": "battery divider"}},
      "7":  {"label": "Boots"},
      "8":  {"label": "Uptime", "unit": "min"},
      "9":  {"label": "Signal", "unit": "dBm", "chart": true, "note": "best path in the last 1-2 minutes (firmware from 2026-09-27; before that, the last packet heard)"},
      "10": {"label": "Battery (node's own %)", "unit": "%", "chart": true, "zero_means": "no divider fitted"},
      "22": {"label": "Action", "writable": true, "min": 0, "max": 5, "action": true},
      "23": {"label": "OTA arm", "writable": true, "min": 0, "max": 255, "action": true},
      "24": {"label": "Seed firmware to node", "writable": true, "min": 0, "max": 255, "action": true},
      "25": {"label": "Firmware CRC", "hex": true},
      "26": {"label": "Last error", "error": true, "note": "code/subject, explained on the Problems page"},
      "27": {"label": "Errors since boot"},
      "250": {"label": "Hops to the hive", "chart": true, "note": "0 = heard directly; 1 = its report only reached the hive through a relay"}
    },
    "derived": {
      "soil": {"type": "soil_pct", "from": 3, "label": "Soil moisture", "unit": "%", "decimals": 0, "chart": true},
      "battery": {"type": "lipo_pct", "from": 5, "label": "Battery", "unit": "%", "decimals": 0, "chart": true},
      "volts": {"type": "volts", "from": 5, "label": "Battery voltage", "unit": "V", "decimals": 2, "chart": true}
    },
    "ok_slot": {"slot": 6, "bits": {"1": "air sensor not reading", "2": "soil probe not reading"}},
    "warn_below": [
      {"slot": "d:battery", "value": 20, "label": "battery low", "ignore": 0, "unit": "%"},
      {"slot": 9, "value": -85, "label": "weak signal", "unit": " dBm"}
    ],
    "actions": [
      {"label": "Reboot", "slot": 22, "value": 4, "confirm": "Reboot this node?"}
    ]
  },
  "RangeNode": {
    "description": "Link-quality probe: answers how well the swarm reaches it",
    "match": {"has": [20, 21], "lacks": []},
    "headline": ["3", "5", "7", "2"],
    "slots": {
      "1":  {"label": "Uptime", "unit": "min"},
      "2":  {"label": "Boots"},
      "3":  {"label": "Signal (best, 2 min)", "unit": "dBm", "chart": true},
      "4":  {"label": "Signal (worst)", "unit": "dBm", "chart": true},
      "5":  {"label": "Neighbours", "chart": true},
      "6":  {"label": "Beacons received"},
      "7":  {"label": "Beacon age", "unit": "s", "chart": true},
      "8":  {"label": "Safe events"},
      "9":  {"label": "Epoch adoptions"},
      "10": {"label": "Orphaned", "bool": true},
      "11": {"label": "Epoch"},
      "12": {"label": "Deafened to node"},
      "13": {"label": "Deafness left", "unit": "s"},
      "20": {"label": "Deafen to node", "writable": true, "min": 0, "max": 255},
      "21": {"label": "Deafen duration", "unit": "s", "writable": true, "min": 0, "max": 1800},
      "22": {"label": "Action", "writable": true, "min": 0, "max": 5, "action": true},
      "23": {"label": "OTA arm", "writable": true, "min": 0, "max": 255, "action": true},
      "24": {"label": "Seed firmware to node", "writable": true, "min": 0, "max": 255, "action": true},
      "25": {"label": "Firmware CRC", "hex": true},
      "26": {"label": "Last error", "error": true, "note": "code/subject, explained on the Problems page"},
      "27": {"label": "Errors since boot"},
      "250": {"label": "Hops to the hive", "chart": true, "note": "0 = heard directly; 1 = its report only reached the hive through a relay"}
    },
    "warn_below": [{"slot": 3, "value": -85, "label": "weak signal", "unit": " dBm"}],
    "actions": [
      {"label": "Reset counters", "slot": 22, "value": 1},
      {"label": "Reset signal floor", "slot": 22, "value": 2},
      {"label": "Forget epoch", "slot": 22, "value": 3, "confirm": "Make this node accept any epoch?"},
      {"label": "Reboot", "slot": 22, "value": 4, "confirm": "Reboot this node?"}
    ]
  },
  "WaterNode": {
